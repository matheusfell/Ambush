# Banco (asyncpg). Ajuste usuário/senha conforme o docker-compose.
DATABASE_URL=postgresql+asyncpg://ambush:ambush@localhost:5432/ambush

# Chave Fernet para criptografar senhas (basic auth, SMTP futuro).
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Concorrência máxima de checagens HTTP simultâneas
CHECK_CONCURRENCY=20

# Logging
LOG_LEVEL=INFO

# Timezone de exibição (armazenamento sempre em UTC)
APP_TIMEZONE=America/Sao_Paulo

# Base URL usada nos links dos e-mails de alerta (dashboard na Fase 3)
APP_BASE_URL=http://localhost:8000
