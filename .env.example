# Banco (asyncpg). Ajuste usuário/senha conforme o docker-compose.
DATABASE_URL=postgresql+asyncpg://ambush:ambush@localhost:5432/ambush

# Chave Fernet para criptografar senhas (basic auth, SMTP).
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Concorrência máxima de checagens HTTP simultâneas
CHECK_CONCURRENCY=20

# Logging
LOG_LEVEL=INFO

# Timezone de exibição (armazenamento sempre em UTC)
APP_TIMEZONE=America/Sao_Paulo

# Base URL do dashboard (links nos e-mails)
APP_BASE_URL=http://localhost:5173

# E-mail — Microsoft 365 Graph (recomendado internamente)
O365_TENANT_ID=
O365_CLIENT_ID=
O365_CLIENT_SECRET=
EMAIL_FROM_ADDR=no-reply@dominio.com

# E-mail — SMTP legado / relay interno
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# JWT
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRE_MINUTES=720

# CORS (frontend Vite)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Admin seed (só cria se a tabela users estiver vazia)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
